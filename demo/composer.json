{
    "name": "supertext/contao-demo",
    "description": "Contao 6 demo site for the Supertext translation bundle",
    "license": "MIT",
    "type": "project",
    "require": {
        "contao/conflicts": "@dev",
        "contao/manager-bundle": "6.0.*",
        "supertext/contao-supertext-translation": "@dev",
        "terminal42/contao-changelanguage": "^3.9"
    },
    "repositories": [
        { "type": "path", "url": "plugin", "options": { "symlink": false } }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "conflict": {
        "contao-components/installer": "<1.3"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "contao-component-dir": "assets"
    },
    "scripts": {
        "post-install-cmd": ["@php vendor/bin/contao-setup"],
        "post-update-cmd": ["@php vendor/bin/contao-setup"]
    }
}
