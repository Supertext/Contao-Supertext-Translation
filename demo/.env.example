# Demo site variables. Set them on the hosting platform (Railway); never commit real values.

# MySQL/MariaDB. On Railway, MYSQLHOST/MYSQLUSER/MYSQLPASSWORD/MYSQLPORT/MYSQLDATABASE
# of a MySQL service are combined automatically if DATABASE_URL is not set.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/contao
APP_SECRET=change-me-to-a-long-random-string

# Supertext AI translation
# No account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, requires the Admin role).
SUPERTEXT_API_KEY=
# live (default), staging or testing
SUPERTEXT_ENVIRONMENT=live
# Optional explicit API base URL (e.g. a local fake), overrides SUPERTEXT_ENVIRONMENT
# SUPERTEXT_API_URL=http://localhost:4010/v1/

# Demo accounts, created on every start if they don't exist yet (existing accounts are
# never changed). Log in at /contao with the e-mail address. Passwords: at least 8 characters.
# Contao has no "create first admin" screen; without these, use `contao:user:create`.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Editor in the "Editors" group: pages + articles in all languages, may translate.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
