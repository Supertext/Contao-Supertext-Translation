{
    "name": "supertext/contao-supertext-translation",
    "description": "Supertext AI translation for Contao: translate pages, articles and content elements into your language roots",
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Supertext AG",
            "homepage": "https://www.supertext.com"
        }
    ],
    "keywords": [
        "contao",
        "translation",
        "localization",
        "multilingual",
        "supertext",
        "ai"
    ],
    "homepage": "https://github.com/Supertext/Contao-Supertext-Translation",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "contao/core-bundle": "^5.7 || ^6.0",
        "doctrine/dbal": "^3.7 || ^4.3",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/mime": "^7.4 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4"
    },
    "conflict": {
        "contao/manager-plugin": "<2.13 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Supertext\\ContaoTranslation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Supertext\\ContaoTranslation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Supertext\\ContaoTranslation\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao/manager-plugin": true,
            "contao-components/installer": true,
            "php-http/discovery": false
        }
    },
    "repositories": {}
}
