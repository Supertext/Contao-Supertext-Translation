{% trans_default_domain 'contao_default' %}
{% extends '@Contao/be_main.html.twig' %}

{% block main_content %}
    <div id="tl_buttons">
        <a href="{{ back_url }}" class="header_back" title="{{ 'MSC.backBTTitle'|trans }}">{{ 'MSC.backBT'|trans }}</a>
    </div>

    <form method="post" class="tl_form tl_edit_form supertext-translate" data-turbo="false">
        <div class="tl_formbody_edit">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">

            <div class="tl_tbox">
                <h2 class="sub_headline">{{ 'MSC.supertext.headline'|trans([page.title]) }}</h2>

                {% if not api_key_configured %}
                    <p class="tl_error">{{ 'MSC.supertext.noApiKey'|trans }}</p>
                    <p class="tl_help tl_tip">{{ 'MSC.supertext.noApiKeyHelp'|trans|raw }}</p>
                {% endif %}

                {% if source_unmapped %}
                    <p class="tl_error">{{ 'MSC.supertext.error_unsupported_language'|trans([source_language]) }}</p>
                {% endif %}

                {% if error %}
                    <p class="tl_error">{{ error|trans }}</p>
                {% endif %}

                {% if report %}
                    {% for target in report.targets %}
                        {% if target.ok %}
                            <div class="tl_confirm">
                                <strong>{{ target.root.title }} ({{ target.root.language }})</strong>:
                                {{ 'MSC.supertext.done'|trans([target.pages|length, target.articles, target.elements]) }}
                                {% if target.hidden %} {{ 'MSC.supertext.hidden'|trans([target.hidden]) }}{% endif %}
                                <ul>
                                    {% for p in target.pages %}
                                        <li>
                                            <a href="{{ path('contao_backend', {do: 'article', pn: p.id}) }}">{{ p.title }}</a>
                                            {% if p.created %}<em>— {{ 'MSC.supertext.created'|trans }}</em>{% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {% if target.missing|length %}
                                <p class="tl_info">{{ 'MSC.supertext.missing'|trans([target.missing|length]) }}</p>
                            {% endif %}
                            {% for warning in target.warnings %}
                                <p class="tl_info">{{ warning[0]|trans(warning[1]) }}</p>
                            {% endfor %}
                        {% else %}
                            {# Known errors are shown in the user's language, others as they are (English). #}
                            {% set error_key = 'MSC.supertext.error_' ~ target.errorCode %}
                            {% set error_message = target.errorCode ? error_key|trans(target.errorParams) : error_key %}
                            <p class="tl_error"><strong>{{ target.root.title }} ({{ target.root.language }})</strong>:
                                {% if error_message == error_key %}{{ target.error }}{% else %}{{ error_message }}{% if target.errorDetail %} — {{ target.errorDetail }}{% endif %}{% endif %}
                            </p>
                            {% if target.errorCode in ['authentication_failure', 'missing_api_key'] %}
                                <p class="tl_help tl_tip">{{ 'MSC.supertext.noApiKeyHelp'|trans|raw }}</p>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if roots is empty %}
                    <p class="tl_info">{{ 'MSC.supertext.noRoots'|trans }}</p>
                {% else %}
                    <div class="widget">
                        <fieldset class="tl_checkbox_container">
                            <legend>{{ 'MSC.supertext.targets'|trans }}</legend>
                            {% for root in roots %}
                                <input type="checkbox" class="tl_checkbox" name="targets[]" id="st_target_{{ root.id }}" value="{{ root.id }}"{% if not root.supertext %} disabled{% elseif root.id in selected or (selected is empty and report is null) %} checked{% endif %}>
                                <label for="st_target_{{ root.id }}" class="tl_checkbox_label">
                                    {{ root.title }} <span class="label-info">[{{ root.language }}{% if root.supertext and root.supertext|lower != root.language|lower|replace({'_': '-'}) %} → {{ root.supertext }}{% endif %}]</span>
                                    {% if not root.supertext %}— <span class="tl_red">{{ 'MSC.supertext.notMapped'|trans }}</span>{% endif %}
                                    {% if root.politeness_unsupported %}— <span class="tl_red">{{ 'MSC.supertext.noPoliteness'|trans }}</span>{% endif %}
                                    {# For a website root the target is the other root, which always exists. #}
                                    {% if page.type != 'root' %}{% if root.targetPageId %}— {{ 'MSC.supertext.exists'|trans }}{% else %}— {{ 'MSC.supertext.new'|trans }}{% endif %}{% endif %}
                                </label>
                                <br>
                            {% endfor %}
                        </fieldset>
                        <p class="tl_help" style="white-space: normal">{{ 'MSC.supertext.help'|trans }}</p>
                    </div>

                    {% if page.has_subpages and page.type != 'root' %}
                        <div class="widget">
                            <div class="tl_checkbox_single_container">
                                <input type="checkbox" class="tl_checkbox" name="subpages" id="st_subpages" value="1"{% if include_subpages %} checked{% endif %}>
                                <label for="st_subpages">{{ 'MSC.supertext.subpages'|trans }}</label>
                            </div>
                        </div>
                    {% elseif page.type == 'root' %}
                        <div class="widget">
                            <p class="tl_help" style="white-space: normal">{{ 'MSC.supertext.rootHelp'|trans }}</p>
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {% if status %}
                {# Administrators only: the latest automatic API key check and the version reports setting. #}
                <div class="tl_tbox supertext-status">
                    <h3>{{ 'MSC.supertext.keyCheck'|trans }}</h3>
                    {% if status.check is null %}
                        <p class="tl_info">{{ 'MSC.supertext.notChecked'|trans }}</p>
                    {% else %}
                        <p class="{{ status.check.status == 'ok' ? 'tl_confirm' : 'tl_error' }}">
                            {{ ('MSC.supertext.keycheck_' ~ status.check.status)|trans([status.check.http_status])|raw }}
                            <em>({{ 'MSC.supertext.checkedAt'|trans([status.check.time]) }})</em>
                        </p>
                    {% endif %}
                    <h3>{{ 'MSC.supertext.reports'|trans }}</h3>
                    <p>{{ (status.reports ? 'MSC.supertext.reportsOn' : 'MSC.supertext.reportsOff')|trans }}{% if status.reports_env %} (SUPERTEXT_VERSION_REPORTS){% endif %}</p>
                    <p class="tl_help" style="white-space: normal">{{ 'MSC.supertext.reportsHelp'|trans }}</p>
                </div>
            {% endif %}
        </div>

        {% if roots is not empty %}
            <div class="tl_formbody_submit">
                <div class="tl_submit_container">
                    <button type="submit" class="tl_submit" onclick="this.disabled=true;this.textContent='{{ 'MSC.supertext.running'|trans|e('js') }}';this.form.submit();"{% if not api_key_configured or source_unmapped %} disabled{% endif %}>
                        {{ 'MSC.supertext.submit'|trans }}
                    </button>
                </div>
            </div>
        {% endif %}
    </form>
    {% if roots is not empty or imports is not null %}
        {# Export for translation / Import translation: files translated outside the API. #}
        <form method="post" class="tl_form tl_edit_form supertext-export" data-turbo="false">
            <div class="tl_formbody_edit">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                <input type="hidden" name="action" value="export">
                <div class="tl_tbox">
                    <h2 class="sub_headline">{{ 'MSC.supertext.fileExport'|trans }}</h2>

                    {% if file_error and file_action == 'export' %}
                        <p class="tl_error">{{ file_error[0]|trans(file_error[1]) }}</p>
                    {% endif %}

                    {% if page.type == 'root' %}
                        <p class="tl_info">{{ 'MSC.supertext.fileRoot'|trans }}</p>
                    {% else %}
                        <div class="widget">
                            <fieldset class="tl_radio_container">
                                <legend>{{ 'MSC.supertext.fileFormat'|trans }}</legend>
                                <input type="radio" class="tl_radio" name="format" id="st_format_xliff" value="xliff" checked>
                                <label for="st_format_xliff">{{ 'MSC.supertext.fileXliff'|trans }}</label><br>
                                <input type="radio" class="tl_radio" name="format" id="st_format_html" value="html">
                                <label for="st_format_html">{{ 'MSC.supertext.fileHtml'|trans }}</label>
                            </fieldset>
                        </div>
                        <div class="widget">
                            <fieldset class="tl_checkbox_container">
                                <legend>{{ 'MSC.supertext.fileTargets'|trans }}</legend>
                                {% for root in roots %}
                                    <input type="checkbox" class="tl_checkbox" name="export_targets[]" id="st_export_{{ root.id }}" value="{{ root.id }}">
                                    <label for="st_export_{{ root.id }}" class="tl_checkbox_label">{{ root.title }} <span class="label-info">[{{ root.language }}{% if root.supertext and root.supertext|lower != root.language|lower|replace({'_': '-'}) %} → {{ root.supertext }}{% endif %}]</span></label><br>
                                {% endfor %}
                            </fieldset>
                            <p class="tl_help" style="white-space: normal">{{ 'MSC.supertext.fileExportHelp'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% if page.type != 'root' %}
                <div class="tl_formbody_submit">
                    <div class="tl_submit_container">
                        <button type="submit" class="tl_submit">{{ 'MSC.supertext.fileDownload'|trans }}</button>
                    </div>
                </div>
            {% endif %}
        </form>

        <form method="post" enctype="multipart/form-data" class="tl_form tl_edit_form supertext-import" data-turbo="false">
            <div class="tl_formbody_edit">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                <input type="hidden" name="action" value="import">
                <div class="tl_tbox">
                    <h2 class="sub_headline">{{ 'MSC.supertext.fileImport'|trans }}</h2>

                    {% if file_error and file_action == 'import' %}
                        <p class="tl_error">{{ file_error[0]|trans(file_error[1]) }}</p>
                    {% endif %}

                    {% for result in imports ?? [] %}
                        {% if result.error %}
                            <p class="tl_error"><strong>{{ result.page }} ({{ result.language }})</strong>: {{ ('MSC.supertext.' ~ result.error)|trans(result.errorParams) }}</p>
                        {% else %}
                            <div class="{{ result.imported ? 'tl_confirm' : 'tl_info' }}">
                                <strong>{{ result.page }} → {{ result.root }} ({{ result.language }})</strong>
                                {% if result.targetPageId %} — <a href="{{ path('contao_backend', {do: 'article', pn: result.targetPageId}) }}">{{ 'MSC.supertext.fileOpen'|trans }}</a>{% endif %}
                                <ul>
                                    <li>{{ 'MSC.supertext.fileOk'|trans([result.imported]) }}</li>
                                    {% if result.counts.source_changed and result.imported < result.counts.ok + result.counts.source_changed %}<li>{{ 'MSC.supertext.fileChanged'|trans([result.counts.source_changed]) }}</li>{% endif %}
                                    {% if result.counts.untranslated %}<li>{{ 'MSC.supertext.fileUntranslated'|trans([result.counts.untranslated]) }}</li>{% endif %}
                                    {% if result.counts.invalid_markup %}<li>{{ 'MSC.supertext.fileInvalid'|trans([result.counts.invalid_markup]) }}</li>{% endif %}
                                    {% if result.counts.missing %}<li>{{ 'MSC.supertext.fileMissing'|trans([result.counts.missing]) }}</li>{% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endfor %}

                    <div class="widget">
                        <h3><label for="st_file">{{ 'MSC.supertext.fileField'|trans }}</label></h3>
                        <input type="file" name="translation_file" id="st_file" class="tl_upload_field" accept=".xlf,.xliff,.html,.htm,application/x-xliff+xml,text/html" required>
                        <p class="tl_help" style="white-space: normal">{{ 'MSC.supertext.fileImportHelp'|trans }}</p>
                    </div>
                    <div class="widget">
                        <div class="tl_checkbox_single_container">
                            <input type="checkbox" class="tl_checkbox" name="include_changed" id="st_include_changed" value="1">
                            <label for="st_include_changed">{{ 'MSC.supertext.fileIncludeChanged'|trans }}</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tl_formbody_submit">
                <div class="tl_submit_container">
                    <button type="submit" class="tl_submit">{{ 'MSC.supertext.fileImport'|trans }}</button>
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}
